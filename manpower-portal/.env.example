# ==============================================================================
# PRAYAS — The Automation Academy | Industry Manpower Requirement Portal
# Environment Configuration Template (.env.example)
# ==============================================================================

# Application Environment (production, staging, development)
APP_NAME="PRAYAS Industry Manpower Requirement Portal"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://portal.prayas-academy.org

# Database Credentials (MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=manpower_portal_db
DB_USER=prayas_db_user
DB_PASS=ChangeThisToStrongPassword123!

# Session & Security Settings
SESSION_LIFETIME=1800
SESSION_SECURE_COOKIE=true

# Outbound Mail (SMTP / MTA)
MAIL_ENABLED=true
MAIL_FROM_ADDRESS=noreply@prayas-academy.org
MAIL_FROM_NAME="PRAYAS – The Automation Academy"
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@prayas-academy.org
SMTP_PASS=YourSmtpPasswordHere
SMTP_ENCRYPTION=tls

# Scheduled Task (Cron) Secret Token
CRON_SECRET_TOKEN=prayas_cron_secure_token_change_in_prod
