# ==============================================================================
# PRAYAS — The Automation Academy Manpower Portal
# Production Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to .env and configure with secure production secrets.
# NEVER commit the actual .env file with real passwords to version control.
# ==============================================================================

# Application Environment
APP_NAME="PRAYAS Industry Manpower Requirement Portal"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://manpower.prayas.org.in
APP_TIMEZONE="Asia/Kolkata"

# Primary Portal MySQL Database (manpower_portal_db)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=manpower_portal_db
DB_USER=prayas_portal_user
DB_PASS=CHANGE_TO_STRONG_UNIQUE_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Read-Only External Candidate Database Bridges
# (Read-only user permissions must be granted at the MySQL level)
CANDIDATE_DB_HOST=127.0.0.1
CANDIDATE_DB_PORT=3306
CANDIDATE_DB_NAME=prayas_iti_dashboard
CANDIDATE_DB_USER=prayas_readonly_user
CANDIDATE_DB_PASS=CHANGE_TO_CANDIDATE_DB_PASSWORD

# Session Security Configuration
SESSION_NAME=PRAYAS_SSID
SESSION_LIFETIME=1800
SESSION_SECURE_COOKIE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# SMTP Email Notification Service
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@prayas.org.in
SMTP_PASS=CHANGE_TO_SECURE_APP_PASSWORD
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=notifications@prayas.org.in
SMTP_FROM_NAME="PRAYAS Recruitment Desk"

# CLI Automation & Cron Security
CRON_SECURITY_TOKEN=GENERATE_64_CHAR_HEX_TOKEN
DEADLINE_REMINDER_DAYS=7

# Error Logging & Audit Storage
LOG_PATH=/var/log/prayas/portal_errors.log
AUDIT_LOG_RETENTION_DAYS=365

