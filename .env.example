# PRAYAS Website & Recruitment Portal Configuration
APP_NAME="PRAYAS - Building India's Manufacturing Workforce"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://prayas-academy.com

# Database Configuration (MySQL / MariaDB)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=student_portal
DB_USER=root
DB_PASS=

# SQLite Fallback File (Relative to project root)
SQLITE_PATH=database/database.sqlite

# Mail / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=admissions@prayas.org
SMTP_PASS=your_smtp_app_password
SMTP_FROM=admissions@prayas.org
SMTP_FROM_NAME="PRAYAS Admissions"
NOTIFY_EMAILS=admissions@prayas.org

# Security & Session Settings
SESSION_LIFETIME=86400
JWT_SECRET=your_random_secure_jwt_secret_key
ADMIN_SECRET_KEY=your_admin_secret_key
